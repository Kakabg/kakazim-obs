# Porta onde o painel escuta (adicione http://localhost:PORT como Browser Source no OBS)
PORT=8420

# --- Twitch ---
# Crie um app dedicado ao painel em https://dev.twitch.tv/console/apps
# OAuth Redirect URL cadastrada no app deve ser: http://localhost:8420/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Login (username) do seu canal na Twitch, ex: kakazim
TWITCH_BROADCASTER_LOGIN=

# --- Kick ---
# Pode reaproveitar o mesmo client_id/secret do kakazim-bot (uso só de leitura,
# via client_credentials - não precisa de autorização de usuário na Kick).
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Slug do seu canal na Kick, ex: kakazim
KICK_BROADCASTER_SLUG=

# --- Relay de eventos da Kick (kakazim-bot no Railway) ---
# URL do endpoint SSE novo (server.js: GET /painel/eventos) e o mesmo valor de
# PAINEL_RELAY_SECRET configurado no kakazim-bot (.env local e nas variáveis de
# ambiente do projeto no Railway).
KICK_RELAY_URL=https://kakazim-bot-production.up.railway.app/painel/eventos
KICK_RELAY_SECRET=

# --- Automações locais ---
CS2_SCENE_SWITCHER_STATUS_URL=http://127.0.0.1:3000/status
